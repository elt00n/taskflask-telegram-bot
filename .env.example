# Режим работы приложения: development, test или production.
APP_ENV=development

# Временный общий часовой пояс до появления пользовательских настроек.
DEFAULT_TIMEZONE=Europe/Moscow

# Токен, который выдаст BotFather. Здесь оставляем пустое значение.
TELEGRAM_BOT_TOKEN=

# Локальный адрес совпадает с настройками compose.yaml.
# В production обязательно используйте отдельный сложный пароль и SSL.
DATABASE_URL=postgres://taskflask:taskflask@localhost:5432/taskflask?sslmode=disable
